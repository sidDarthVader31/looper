{
  "name": "looper",
  "displayName": "Looper",
  "description": "Visualize the Node.js call stack, microtask queue, and macrotask queue live from inside VS Code.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "SiddharthBisht31",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidDarthVader31/looper.git"
  },
  "icon": "assets/icon.png",
  "author": {
    "name": "Siddharth Bisht",
    "email": "siddharthbisht31@gmail.com"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers", "Visualization"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "looper.launch",
        "title": "Looper: Launch & Visualize"
      },
      {
        "command": "looper.attach",
        "title": "Looper: Attach to Running Process"
      },
      {
        "command": "looper.stop",
        "title": "Looper: Stop Session"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
