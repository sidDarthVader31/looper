{
  "name": "event-loop-visualizer",
  "displayName": "Event Loop Visualizer",
  "description": "Visualize the Node.js call stack, microtask queue, and macrotask queue live from inside VS Code.",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers", "Visualization"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eventLoopViz.launch",
        "title": "Event Loop Visualizer: Launch & Visualize"
      },
      {
        "command": "eventLoopViz.attach",
        "title": "Event Loop Visualizer: Attach to Running Process"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
